# Copy to .env for local development.
#
# .env is read only by the settings classes: the Application, Participant and
# config-path sections below. Everything else (CELINE_OIDC_*, and the ${VAR}s in
# config/*.yaml) is read from the process environment — export it in your shell
# or pass it to the container; putting it in .env alone has no effect.

# ── Application (read from .env) ───────────────────────────
# Environment name, also read as CELINE_ENV or ENV. Anything other than
# dev / development / local / test / ci (including unset) is production, and
# production refuses to start with a service secret that is empty or equal to
# the client id.
APP_ENV=dev
LOG_LEVEL=INFO

# ── Participant domain (read from .env) ────────────────────
# PARTICIPANT_REGISTRY_BASE_URL=http://api.celine.localhost/rec-registry
# PARTICIPANT_REGISTRY_TIMEOUT=5

# ── Config file paths (read from .env) ─────────────────────
# DOMAINS_CONFIG_PATHS=["config/domains.yaml"]
# CLIENTS_CONFIG_PATHS=["config/clients.yaml"]
# BROKERS_CONFIG_PATHS=["config/brokers.yaml"]

# ── OIDC service identity (process environment) ────────────
# Client id is fixed to svc-digital-twin. Set CELINE_OIDC_BASE_URL empty to run
# with no service identity (boundary fetchers then answer 503).
# CELINE_OIDC_BASE_URL=http://keycloak.celine.localhost/realms/celine
# CELINE_OIDC_CLIENT_SECRET=svc-digital-twin
# CELINE_OIDC_SCOPE=
# CELINE_OIDC_VERIFY_SSL=true

# ── MQTT broker, config/brokers.yaml (process environment) ─
# MQTT_HOST=host.docker.internal
# MQTT_PORT=1883
# MQTT_USE_TLS=false
# Static credentials, only when auth_with_token is off:
# MQTT_USERNAME=
# MQTT_PASSWORD=
# Broker a domain's event handlers use, config/domains.yaml overrides.broker:
# MQTT_BROKER=celine_mqtt

# ── Clients, config/clients.yaml (process environment) ─────
# DATASET_API_BASE_URL=http://host.docker.internal:8001
# NUDGING_URL=http://host.docker.internal:8016
# REC_REGISTRY_URL=http://host.docker.internal:8004
